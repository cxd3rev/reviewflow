{
  "name": "reviewflow",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Automatically request reviews after completed jobs.",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c teal,blue \"npm run dev -w reviewflow-server\" \"npm run dev -w reviewflow-client\"",
    "dev:server": "npm run dev -w reviewflow-server",
    "dev:client": "npm run dev -w reviewflow-client",
    "build": "npm run build -w reviewflow-client",
    "build:pages": "node scripts/build-pages.js",
    "start": "npm run start -w reviewflow-server",
    "seed": "npm run seed -w reviewflow-server",
    "clean:deps": "node scripts/clean-deps.js",
    "pack:github": "node scripts/pack-github.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
